#!/bin/bash

set -euo pipefail

# -------------------------------
# DevOps CI/CD Build Tool
# Version: 2.0.1
# Description: Advanced Docker image builder with SBOM and provenance support
# Author: DevOps Team
# Updates: Auto permission management, builder resource limits, auto-recovery
# -------------------------------

# Version information
VERSION="2.0.1"
BUILD_DATE="$(date +%Y-%m-%d)"

# -------------------------------
# Helper: Tampilkan versi
# -------------------------------
show_version() {
  cat <<EOF
🔧 DevOps CI/CD Build Tool v${VERSION}
Build Date: ${BUILD_DATE}
EOF
}

# -------------------------------
# Helper: Log message (dengan support JSON/SHORT mode)
# -------------------------------
log_message() {
  # Show messages in default and JSON mode, silent only in SHORT mode
  if [[ "$SHORT_OUTPUT" == "false" ]]; then
    # Jika JSON mode dan output di-pipe, kirim ke stderr
    # Jika tidak, kirim ke stdout seperti biasa
    if [[ "$JSON_OUTPUT" == "true" ]] && [ ! -t 1 ]; then
      echo "$@" >&2
    else
      echo "$@"
    fi
  fi
}

# -------------------------------
# Helper: Output JSON result
# -------------------------------
output_json_result() {
  local build_end_time=$(date +%s)
  local build_duration=$((build_end_time - BUILD_START_TIME))

  # Convert boolean values properly
  local rebuild_json="false"
  [[ "$REBUILD" == "true" ]] && rebuild_json="true"

  local ready_json="false"
  [[ "$ready" == "true" ]] && ready_json="true"

  # Escape double quotes in error message
  local error_escaped="${BUILD_ERROR//\"/\\\"}"

  # Format duration as human-readable
  local duration_formatted=""
  if [[ $build_duration -ge 3600 ]]; then
    local hours=$((build_duration / 3600))
    local minutes=$(((build_duration % 3600) / 60))
    local seconds=$((build_duration % 60))
    duration_formatted="${hours}h ${minutes}m ${seconds}s"
  elif [[ $build_duration -ge 60 ]]; then
    local minutes=$((build_duration / 60))
    local seconds=$((build_duration % 60))
    duration_formatted="${minutes}m ${seconds}s"
  else
    duration_formatted="${build_duration}s"
  fi

  cat <<EOF
{
  "status": "$BUILD_STATUS",
  "repository": "$REPO",
  "branch": "$REFS",
  "image": "$build_image",
  "rebuild": $rebuild_json,
  "build_time": {
    "start_unix": $BUILD_START_TIME,
    "end_unix": $build_end_time,
    "start_iso": "$(date -u -d @$BUILD_START_TIME +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r $BUILD_START_TIME +%Y-%m-%dT%H:%M:%SZ)",
    "end_iso": "$(date -u -d @$build_end_time +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r $build_end_time +%Y-%m-%dT%H:%M:%SZ)",
    "duration": {
      "seconds": $build_duration,
      "formatted": "$duration_formatted"
    }
  },
  "config": {
    "memory": "$DEFAULT_MEMORY",
    "cpus": "$DEFAULT_CPUS",
    "cpu_period": "$DEFAULT_CPU_PERIOD",
    "cpu_quota": "$DEFAULT_CPU_QUOTA",
    "builder": "$BUILDER_NAME"
  },
  "metadata": {
    "ready": $ready_json,
    "custom_image": "$CUSTOM_IMAGE",
    "api_url": "$DEFAULT_URL_API"
  },
  "error": "$error_escaped",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
}

# -------------------------------
# Helper: Setup and verify buildx builder
# -------------------------------
setup_buildx_builder() {
  local builder_name="$1"

  # Fix permissions on Docker buildx directory if it exists
  if [[ -d ~/.docker/buildx ]]; then
    log_message "🔧 Checking Docker buildx permissions..."

    # Check if we have write access
    if [[ ! -w ~/.docker/buildx ]]; then
      log_message "⚠️  Fixing Docker buildx directory permissions..."
      sudo chown -R "$(whoami):$(whoami)" ~/.docker/buildx 2>/dev/null || {
        # If sudo chown fails, try without sudo
        chmod -R u+rw ~/.docker/buildx 2>/dev/null || true
      }
    fi

    # Check and fix permissions on activity directory and files
    if [[ -d ~/.docker/buildx/activity ]]; then
      # Fix directory permissions
      if [[ ! -w ~/.docker/buildx/activity ]]; then
        log_message "⚠️  Fixing Docker buildx activity directory permissions..."
        sudo chown -R "$(whoami):$(whoami)" ~/.docker/buildx/activity 2>/dev/null || {
          chmod -R u+rw ~/.docker/buildx/activity 2>/dev/null || true
        }
      fi

      # Fix individual file permissions (especially those owned by root)
      for activity_file in ~/.docker/buildx/activity/*; do
        if [[ -f "$activity_file" ]] && [[ ! -w "$activity_file" ]]; then
          log_message "⚠️  Fixing permissions on $(basename "$activity_file")..."
          sudo chown "$(whoami):$(whoami)" "$activity_file" 2>/dev/null || {
            chmod u+rw "$activity_file" 2>/dev/null || true
          }
        fi
      done
    fi

    # Check and fix permissions on refs directory (especially subdirectories owned by root)
    if [[ -d ~/.docker/buildx/refs ]]; then
      for refs_dir in ~/.docker/buildx/refs/*; do
        if [[ -d "$refs_dir" ]] && [[ ! -r "$refs_dir" || ! -w "$refs_dir" || ! -x "$refs_dir" ]]; then
          log_message "⚠️  Fixing permissions on refs/$(basename "$refs_dir")..."
          sudo chown -R "$(whoami):$(whoami)" "$refs_dir" 2>/dev/null || {
            chmod -R u+rwx "$refs_dir" 2>/dev/null || true
          }
        fi
      done
    fi
  fi

  # Check if builder exists
  log_message "🔍 Verifying builder '$builder_name'..."
  if docker buildx ls 2>/dev/null | grep -q "$builder_name"; then
    log_message "✅ Builder '$builder_name' exists"

    # Try to use the builder
    if docker buildx use "$builder_name" 2>/dev/null; then
      log_message "✅ Successfully switched to builder '$builder_name'"

      # Apply/update resource limits on existing builder
      log_message "🔧 Checking resource limits on builder container..."
      local container_name=$(docker ps -a --filter "name=buildx_buildkit_${builder_name}" --format "{{.Names}}" | head -n 1)

      if [[ -n "$container_name" ]]; then
        # Check if container is running, start it if not
        local container_status=$(docker inspect -f '{{.State.Status}}' "$container_name" 2>/dev/null || echo "not_found")

        if [[ "$container_status" != "running" ]]; then
          log_message "⚡ Starting builder container..."
          docker start "$container_name" >/dev/null 2>&1 || true
          sleep 2
        fi

        # Apply resource limits (with memory-swap to avoid conflicts)
        if docker update --cpus="4" --memory="4g" --memory-swap="4g" "$container_name" >/dev/null 2>&1; then
          log_message "✅ Resource limits applied/updated: 4 CPUs, 4GB RAM"
        fi
      fi

      return 0
    else
      log_message "⚠️  Could not switch to builder '$builder_name', recreating..."
      # Remove the broken builder
      docker buildx rm "$builder_name" 2>/dev/null || true
    fi
  fi

  # Create builder if it doesn't exist or was broken
  log_message "🔨 Creating builder '$builder_name' with resource limits (4 CPUs, 4GB RAM)..."

  # Clean up any leftover instance/activity files that might cause conflicts
  if [[ -f ~/.docker/buildx/instances/"$builder_name" ]] || [[ -f ~/.docker/buildx/activity/"$builder_name" ]]; then
    log_message "🧹 Cleaning up leftover builder files..."
    rm -f ~/.docker/buildx/instances/"$builder_name" ~/.docker/buildx/activity/"$builder_name" 2>/dev/null || true
  fi

  if docker buildx create --name "$builder_name" --driver docker-container --use 2>/dev/null; then
    log_message "✅ Builder '$builder_name' created successfully"

    # Bootstrap the builder to create the container
    log_message "⚡ Bootstrapping builder to start container..."
    docker buildx inspect --bootstrap "$builder_name" >/dev/null 2>&1 || true
    sleep 3  # Wait for container to fully start

    # Apply resource limits to the builder container
    log_message "🔧 Applying resource limits to builder container..."
    local container_name=$(docker ps -a --filter "name=buildx_buildkit_${builder_name}" --format "{{.Names}}" | head -n 1)

    if [[ -n "$container_name" ]]; then
      if docker update --cpus="4" --memory="4g" --memory-swap="4g" "$container_name" >/dev/null 2>&1; then
        log_message "✅ Resource limits applied: 4 CPUs, 4GB RAM"
      else
        log_message "⚠️  Warning: Could not apply resource limits to builder container"
      fi
    else
      log_message "⚠️  Warning: Could not find builder container to apply limits"
      log_message "   Limits will be applied on first use"
    fi

    return 0
  else
    log_message "⚠️  Warning: Could not create builder '$builder_name'"
    log_message "   Attempting to use default builder..."
    return 1
  fi
}

# -------------------------------
# Helper: Send notification to ntfy.sh
# -------------------------------
send_ntfy_notification() {
  local ntfy_url="${NTFY_URL:-https://ntfy.sh/doi-notif}"
  local json_payload=$(output_json_result)

  # Determine notification title and priority based on build status
  local title="🔧 Build ${BUILD_STATUS^}: $REPO"
  local priority="default"
  local tags="package"

  case "$BUILD_STATUS" in
    success)
      title="✅ Build Success: $REPO"
      priority="high"
      tags="white_check_mark,package"
      ;;
    failed)
      title="❌ Build Failed: $REPO"
      priority="urgent"
      tags="x,package,warning"
      ;;
    skipped)
      title="⏭️ Build Skipped: $REPO"
      priority="low"
      tags="fast_forward,package"
      ;;
  esac

  # Send notification to ntfy.sh
  curl -sS \
    -H "Title: $title" \
    -H "Priority: $priority" \
    -H "Tags: $tags" \
    -H "Content-Type: application/json" \
    -d "$json_payload" \
    "$ntfy_url" > /dev/null 2>&1

  local curl_exit_code=$?
  if [[ $curl_exit_code -eq 0 ]]; then
    log_message "📤 Notification sent to ntfy.sh"
  else
    log_message "⚠️  Warning: Failed to send notification to ntfy.sh (exit code: $curl_exit_code)"
  fi
}

