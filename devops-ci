# -------------------------------
# Validasi & parsing argumen
# -------------------------------
REPO=${1:-}
REFS=${2:-}
REBUILD=false
JSON_OUTPUT=false
SHORT_OUTPUT=false
CUSTOM_IMAGE=""
BUILD_START_TIME=$(date +%s)
BUILD_STATUS="pending"
BUILD_ERROR=""
build_image=""
ready="false"
BUILDER_NAME="container-builder"

# Tampilkan help jika argumen kurang atau --help
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  show_help
  exit 0
fi

# Tampilkan versi jika diminta
if [[ "$1" == "--version" || "$1" == "-v" ]]; then
  show_version
  exit 0
fi

# Validasi argumen wajib
if [[ -z "$REPO" ]]; then
  echo "❌ Error: Repository name is required"
  echo "   Usage: $(basename "$0") <REPO> <REFS> [--rebuild] [CUSTOM_IMAGE]"
  echo "   Example: $(basename "$0") saas-be-core develop"
  echo ""
  echo "   Use --help for more information"
  exit 1
fi

if [[ -z "$REFS" ]]; then
  echo "❌ Error: Branch/tag name is required"
  echo "   Usage: $(basename "$0") <REPO> <REFS> [--rebuild] [CUSTOM_IMAGE]"
  echo "   Example: $(basename "$0") $REPO develop"
  echo ""
  echo "   Use --help for more information"
  exit 1
fi

# Validasi format repository name (basic check)
if [[ ! "$REPO" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "❌ Error: Invalid repository name '$REPO'"
  echo "   Repository name should contain only letters, numbers, hyphens, and underscores"
  exit 1
fi

# Parse optional arguments (--rebuild, --json, --short, CUSTOM_IMAGE)
shift 2  # Remove REPO and REFS from arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --rebuild)
      REBUILD=true
      [[ "$SHORT_OUTPUT" == "false" ]] && echo "🔄 Rebuild mode enabled"
      shift
      ;;
    --json)
      JSON_OUTPUT=true
      SHORT_OUTPUT=false
      shift
      ;;
    --short)
      SHORT_OUTPUT=true
      JSON_OUTPUT=false
      shift
      ;;
    *)
      # Assume this is CUSTOM_IMAGE
      CUSTOM_IMAGE="$1"
      [[ "$SHORT_OUTPUT" == "false" ]] && echo "📝 Custom image specified: $CUSTOM_IMAGE"
      shift
      ;;
  esac
done

# -------------------------------
# Default resource limits
# -------------------------------
: "${DEFAULT_MEMORY:=2g}"
: "${DEFAULT_CPUS:=1}"
: "${DEFAULT_CPU_PERIOD:=100000}"
: "${DEFAULT_CPU_QUOTA:=100000}"
: "${DEFAULT_URL_API:=http://193.1.1.3:5000}"
: "${REGISTRY01_URL:=}"
: "${REFS:=}"
: "${IMAGE:=}"
: "${PORT:=}"
: "${PORT2:=}"
: "${GITUSERTOKEN:=}"
: "${BITBUCKET_USER:=}"
: "${GITHUB_USER:=}"
: "${BITBUCKET_TOKEN:=}"
: "${GITHUB_TOKEN:=}"

# -------------------------------
# Setup exit handler untuk JSON/SHORT output
# -------------------------------
cleanup() {
  # Send notification to ntfy.sh
  send_ntfy_notification

  if [[ "$JSON_OUTPUT" == "true" ]]; then
    # Jika output di-pipe (not a tty), output hanya JSON
    # Jika output ke terminal, tampilkan dengan separator
    if [ -t 1 ]; then
      # Output ke terminal (interactive)
      echo ""
      echo "========== BUILD RESULT (JSON) =========="
      output_json_result
      echo "=========================================="
    else
      # Output di-pipe atau redirect, hanya JSON
      output_json_result
    fi
  elif [[ "$SHORT_OUTPUT" == "true" ]]; then
    echo "$build_image"
  fi
}

trap cleanup EXIT

# -------------------------------
# Ambil metadata dari API
# -------------------------------
log_message "📦 Fetching build metadata for repo=$REPO, refs=$REFS ..."
response=$(curl -sX GET "${DEFAULT_URL_API}/v1/image/fe?repo=$REPO&refs=$REFS" -H "accept: application/json")

# Check if API call was successful
if [[ $? -ne 0 ]]; then
  BUILD_STATUS="failed"
  BUILD_ERROR="Failed to fetch build metadata from API"
  log_message "❌ Error: Failed to fetch build metadata from API"
  log_message "   Please check your network connection and API endpoint"
  exit 1
fi

# Check if response is valid JSON
if ! echo "$response" | jq . >/dev/null 2>&1; then
  BUILD_STATUS="failed"
  BUILD_ERROR="Invalid response from API: $response"
  log_message "❌ Error: Invalid response from API"
  log_message "   Response: $response"
  exit 1
fi

ready=$(echo "$response" | jq -r '.ready')

# Check if ready field exists
if [[ "$ready" == "null" ]]; then
  BUILD_STATUS="failed"
  BUILD_ERROR="Invalid response format from API - missing 'ready' field"
  log_message "❌ Error: Invalid response format from API"
  log_message "   Missing 'ready' field in response"
  exit 1
fi

# -------------------------------
# Tentukan build_image
# -------------------------------
if [ -n "$CUSTOM_IMAGE" ]; then
  build_image="$CUSTOM_IMAGE"
  log_message "📝 Using custom image: $build_image"
elif [ "$REBUILD" = true ]; then
  if [ "$ready" = "true" ]; then
    build_image=$(echo "$response" | jq -r '.["image"]')
    log_message "♻️  Rebuilding existing image: $build_image"
  else
    build_image=$(echo "$response" | jq -r '.["build-image"]')
    log_message "🆕 Building new image: $build_image"
  fi
else
  if [ "$ready" = "true" ]; then
    build_image=$(echo "$response" | jq -r '.["image"]')
    BUILD_STATUS="skipped"
    log_message "✅ Image already ready: $build_image. Skipping build."
    exit 0
  else
    build_image=$(echo "$response" | jq -r '.["build-image"]')
    log_message "🆕 Building new image: $build_image"
  fi
fi


# -------------------------------
# Jalankan proses build
# -------------------------------
log_message "🚧 Starting build process..."
log_message "📋 Build configuration:"
log_message "   Repository: $REPO"
log_message "   Branch/Tag: $REFS"
log_message "   Image: $build_image"
log_message "   Rebuild: $REBUILD"
log_message "   Memory: $DEFAULT_MEMORY"
log_message "   CPUs: $DEFAULT_CPUS"

# Fetch configuration from API
log_message "📥 Fetching build configuration..."
config_response=$(curl -sX GET "${DEFAULT_URL_API}/v1/file?repo=$REPO&refs=$REFS&path=cicd%2Fcicd.json" -H "accept: application/json")

# Check if config API call was successful
if [[ $? -ne 0 ]]; then
  BUILD_STATUS="failed"
  BUILD_ERROR="Failed to fetch build configuration from API"
  log_message "❌ Error: Failed to fetch build configuration from API"
  exit 1
fi

# Check if config response is valid JSON
if ! echo "$config_response" | jq . >/dev/null 2>&1; then
  BUILD_STATUS="failed"
  BUILD_ERROR="Invalid configuration response from API: $config_response"
  log_message "❌ Error: Invalid configuration response from API"
  log_message "   Response: $config_response"
  exit 1
fi

# Load configuration
eval "$(echo "$config_response" | jq -r '. | to_entries | .[] | .key + "=\"" + .value + "\""')"

# Load authentication
if [[ ! -f ~/.devops/auth.json ]]; then
  BUILD_STATUS="failed"
  BUILD_ERROR="Authentication file ~/.devops/auth.json not found"
  log_message "❌ Error: Authentication file ~/.devops/auth.json not found"
  log_message "   Please ensure the authentication file exists and is accessible"
  exit 1
fi

eval "$(jq -r '. | to_entries | .[] | .key + "=\"" + .value + "\""' < ~/.devops/auth.json)"

# Setup and verify buildx builder before building
setup_buildx_builder "$BUILDER_NAME"

log_message "🔨 Executing Docker buildx command..."
BUILD_STATUS="building"

# ============================================================================
# GIT SUBMODULE FIX: PRE-CLONE WITH --no-recurse-submodules
# ============================================================================
# PROBLEM:
#   Docker buildx's "load git source" phase attempts to initialize git
#   submodules when cloning from git URL. If repository has incomplete
#   .gitmodules (missing URL for a submodule), git fails with:
#   "fatal: No url found for submodule path '...' in .gitmodules"
#
# SOLUTION:
#   1. Pre-clone repository locally with --no-recurse-submodules flag
#      This skips submodule initialization at clone time
#   2. Pass local directory to docker buildx build instead of git URL
#      This avoids docker buildx attempting git submodule operations
#   3. Cleanup temporary directory after build completes
#
# AFFECTED REPOSITORIES:
#   - saas-apigateway (has ngenwal-alto-apigateway submodule)
#   - Any other repo with incomplete .gitmodules configuration
#
# TECHNICAL DETAILS:
#   - Uses --no-recurse-submodules: Skips recursive clone of submodules
#   - Temp directory: /tmp/buildx-<REPO>-<REFS>-<PID>
#   - Works across all output modes: SHORT, JSON, DEFAULT
# ============================================================================

# Pre-clone repository with --no-recurse-submodules to avoid submodule errors
log_message "📥 Pre-cloning repository (avoiding submodule issues)..."
CLONE_DIR="/tmp/buildx-${REPO}-${REFS}-$$"  # Temp directory: /tmp/buildx-<REPO>-<REFS>-<PID>
mkdir -p "$CLONE_DIR"  # Create temporary directory

# Clone with --no-recurse-submodules to skip submodule initialization
# This prevents the "No url found for submodule" error
if ! git clone --no-recurse-submodules -b "$REFS" "https://${BITBUCKET_USER}:${BITBUCKET_TOKEN}@bitbucket.org/loyaltoid/${REPO}.git" "$CLONE_DIR" >/dev/null 2>&1; then
  BUILD_STATUS="failed"
  BUILD_ERROR="Failed to pre-clone repository"
  log_message "❌ Error: Failed to pre-clone repository"
  rm -rf "$CLONE_DIR"  # Cleanup on failure
  exit 1
fi
log_message "✅ Repository pre-cloned successfully"

# Redirect docker output only for SHORT mode (JSON mode shows progress)
if [[ "$SHORT_OUTPUT" == "true" ]]; then
  # Short mode: silent build
  # Note: Using $CLONE_DIR (local path) instead of git URL prevents
  #       docker buildx from attempting git submodule initialization
  docker buildx build \
    --builder container-builder \
    --sbom=true \
    --no-cache \
    --attest type=provenance,mode=max \
    --memory "$DEFAULT_MEMORY" \
    --cpu-period "$DEFAULT_CPU_PERIOD" \
    --cpu-quota "$DEFAULT_CPU_QUOTA" \
    --progress=plain \
    --build-arg REGISTRY01="$REGISTRY01_URL" \
    --build-arg BRANCH="$REFS" \
    --build-arg PROJECT="$IMAGE" \
    --build-arg PORT="$PORT" \
    --build-arg PORT2="$PORT2" \
    --build-arg GITUSERTOKEN="$GITUSERTOKEN" \
    --build-arg BITBUCKET_USER="$BITBUCKET_USER" \
    --build-arg GITHUB_USER="$GITHUB_USER" \
    --build-arg BITBUCKET_TOKEN="$BITBUCKET_TOKEN" \
    --build-arg GITHUB_TOKEN="$GITHUB_TOKEN" \
    --build-arg GIT_TERMINAL_PROMPT=0 \
    --build-arg GIT_AUTHOR_NAME="CI" \
    --build-arg GIT_AUTHOR_EMAIL="ci@loyalto.id" \
    --build-arg GIT_SUBMODULE_STRATEGY=none \
    -t "$build_image" \
    --push \
    "$CLONE_DIR" >/dev/null 2>&1

  if [[ $? -eq 0 ]]; then
    BUILD_STATUS="success"
  else
    BUILD_STATUS="failed"
    BUILD_ERROR="Docker buildx command failed"
  fi
else
  # Default mode atau JSON mode interactive: output normal
  # Note: Using $CLONE_DIR (local path) instead of git URL prevents
  #       docker buildx from attempting git submodule initialization
  docker buildx build \
    --builder container-builder \
    --sbom=true \
    --no-cache \
    --attest type=provenance,mode=max \
    --memory "$DEFAULT_MEMORY" \
    --cpu-period "$DEFAULT_CPU_PERIOD" \
    --cpu-quota "$DEFAULT_CPU_QUOTA" \
    --progress=plain \
    --build-arg REGISTRY01="$REGISTRY01_URL" \
    --build-arg BRANCH="$REFS" \
    --build-arg PROJECT="$IMAGE" \
    --build-arg PORT="$PORT" \
    --build-arg PORT2="$PORT2" \
    --build-arg GITUSERTOKEN="$GITUSERTOKEN" \
    --build-arg BITBUCKET_USER="$BITBUCKET_USER" \
    --build-arg GITHUB_USER="$GITHUB_USER" \
    --build-arg BITBUCKET_TOKEN="$BITBUCKET_TOKEN" \
    --build-arg GITHUB_TOKEN="$GITHUB_TOKEN" \
    --build-arg GIT_TERMINAL_PROMPT=0 \
    --build-arg GIT_AUTHOR_NAME="CI" \
    --build-arg GIT_AUTHOR_EMAIL="ci@loyalto.id" \
    --build-arg GIT_SUBMODULE_STRATEGY=none \
    -t "$build_image" \
    --push \
    "$CLONE_DIR"

  if [[ $? -eq 0 ]]; then
    BUILD_STATUS="success"
    log_message "✅ Build complete: $build_image"
  else
    BUILD_STATUS="failed"
    BUILD_ERROR="Docker buildx command failed"
    log_message "❌ Build failed"
    exit 1
  fi
fi

