# After docker buildx build completes (success or failure), clean up the
# temporary directory to free up disk space. This ensures no orphaned
# directories are left behind from the pre-clone operation.
# ============================================================================
# Cleanup temporary clone directory
[[ -d "$CLONE_DIR" ]] && rm -rf "$CLONE_DIR"%                                                         